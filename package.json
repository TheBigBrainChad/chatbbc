{
  "name": "chatbbc",
  "version": "2.2.0",
  "description": "ChatBBC: a local MCP workspace for ChatGPT with approved-folder tools, browser integration, and durable workflows.",
  "license": "MIT",
  "author": "TheBigBrainChad",
  "homepage": "https://github.com/TheBigBrainChad/chatbbc",
  "desktopName": "com.chatbbc.app.desktop",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run verify:local",
    "verify:local": "npm run verify:rebrand && npm run verify:upstream-map && npm run rg && npm run verify:privacy && npm run verify:notices && npm run typecheck && node -e \"require('electron')\" && vitest run --exclude test/mcp-shutdown.test.ts --exclude test/computer.test.ts && vitest run --maxWorkers=1 test/computer.test.ts test/mcp-shutdown.test.ts",
    "verify:rebrand": "node scripts/verify-rebrand.mjs",
    "verify:upstream-map": "node scripts/verify-upstream-map.mjs",
    "verify:notices": "node scripts/generate-third-party-notices.mjs --check && node scripts/package-native-sources.mjs --check",
    "verify:privacy": "node scripts/verify-public-history.mjs",
    "verify:tunnel-current": "node scripts/verify-current-tunnel.mjs",
    "verify:ui": "node scripts/verify-local-ui.mjs",
    "hooks:install": "node scripts/install-git-hooks.mjs",
    "icon": "node scripts/make-icon.mjs",
    "tunnel": "node scripts/fetch-tunnel-client.mjs",
    "rg": "node scripts/fetch-ripgrep.mjs",
    "packaging:prepare": "node scripts/prepare-packaging-native.mjs",
    "dist": "node scripts/package.mjs --platform linux --arch x64",
    "dist:linux:x64": "node scripts/package.mjs --platform linux --arch x64",
    "dist:dir": "node scripts/package.mjs --platform linux --arch x64 --dir",
    "dist:dir:linux:x64": "node scripts/package.mjs --platform linux --arch x64 --dir",
    "release:local": "node scripts/release-local.mjs",
    "release:publish": "node scripts/release-local.mjs --publish",
    "test:kill": "node scripts/kill-stray-vitest.mjs"
  },
  "dependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/merge": "6.12.2",
    "@codemirror/state": "6.7.4",
    "@img/sharp-wasm32": "0.35.4",
    "@jitl/quickjs-wasmfile-release-sync": "0.32.0",
    "@lezer/highlight": "^1.2.3",
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "codemirror": "^6.0.2",
    "fflate": "^0.8.3",
    "js-yaml": "4.3.2",
    "koffi": "3.3.2",
    "marked": "18.0.13",
    "node-pty": "1.2.0-beta.15",
    "pdfjs-dist": "^6.3.289",
    "quickjs-emscripten-core": "0.32.0",
    "sharp": "0.35.4",
    "smol-toml": "1.8.0",
    "tree-sitter": "0.25.1",
    "tree-sitter-bash": "0.25.1",
    "ws": "8.21.3",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@phosphor-icons/web": "2.1.2",
    "@types/js-yaml": "4.0.9",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.13.4",
    "@types/ws": "8.18.1",
    "electron": "44.3.0",
    "electron-builder": "^26.16.1",
    "electron-vite": "^5.0.0",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "@anthropic-ai/mcpb": {
      "tmp": "0.2.7"
    }
  }
}
